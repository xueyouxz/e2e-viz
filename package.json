{
  "name": "e2e-viz",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone projection map and scene viewer visualization app",
  "type": "module",
  "author": "xyxz",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build_glyph_atlas.mjs --ensure-if-present && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{css,less,scss}\"",
    "format": "prettier --write .",
    "test": "vitest run && pnpm test:server && pnpm test:scripts",
    "test:server": "pnpm --dir server test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "size": "node scripts/check_bundle.mjs",
    "build:glyph-atlas": "node scripts/build_glyph_atlas.mjs",
    "validate:glyph-atlas": "node scripts/build_glyph_atlas.mjs --validate",
    "render:glyphs": "node scripts/render_glyphs.mjs --force && pnpm build:glyph-atlas",
    "sync:data": "node scripts/sync-data.mjs",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm lint:style && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm test:server && pnpm test:scripts && pnpm build && pnpm size",
    "check:unused": "knip"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-virtual": "^3.13.24",
    "d3": "^7.9.0",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.5",
    "three": "^0.183.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.4.0",
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard": "^37.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
